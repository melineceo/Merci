# Сборка
build/
build-*/
repo/
dist/
.flatpak-builder/

# Готовые пакеты и ключи подписи: и то и другое собирается на месте, а
# ключ вообще не должен покидать машину.
*.apk
*.idsig
*.keystore

# Байт-код Python
__pycache__/
*.py[cod]

# Мусор рабочего стола
.DS_Store
*~

# Исходник значка лежит в data/icons/, в корне он не нужен
/*.ico

# Копия сайта hackerstone.xyz лежит рядом для удобства правок, но это чужой
# проект и в репозиторий Merci ему нельзя: там боевые ключи (config.local.php),
# админка и выгрузки. Публичный репозиторий такого не прощает.
#
# Архивы того же сайта — тем более: один такой уже уходил в коммит, и спасло
# только ограничение GitHub на размер файла.
/site/
/site*.zip
/*.zip
